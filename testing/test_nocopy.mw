% Zero-copy (nocopy input/output/inout) test wrappers.
% Test double, float, dcomplex, fcomplex.

% --- double ---
$void NocopyTimesTwo_double(double *A, double *B, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) B[i] = 2.0 * A[i];
$}

$void NocopyInplace_double(double *A, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) A[i] = 3.0 * A[i];
$}

% --- float ---
$void NocopyTimesTwo_float(float *A, float *B, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) B[i] = 2.0f * A[i];
$}

$void NocopyInplace_float(float *A, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) A[i] = 3.0f * A[i];
$}

