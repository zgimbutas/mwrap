$void NocopyTimesTwo_double(double *A,
$                           double *B,
$                           int const N)
${
$   int i;
$   for(i = 0; i<N; i++){
$        B[i] = 2.0 * A[i];
$    }
$}

$void NocopyTimesTwo_int32(int32_t *A,
$                          int32_t *B,
$                          int const N)
${
$   int i;
$   for(i = 0; i<N; i++){
$        B[i] = 2 * A[i];
$    }
$}

$void NocopyInplace_double(double *A,
$                           int const N)
${
$   int i;
$   for(i = 0; i<N; i++){
$        A[i] = 3.0 * A[i];
$    }
$}

@function result = nocopy_timestwo_double(a)
