@function result = nocopy_timestwo_double(a)
  n = numel(a);
  # NocopyTimesTwo_double(nocopy input double[] a, nocopy output double[n] result, int n);
end

@function a = nocopy_inplace_double(a)
  n = numel(a);
  # NocopyInplace_double(nocopy inout double[] a, int n);
end

