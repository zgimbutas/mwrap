% Zero-copy (cinput/coutput/cinout) test wrappers.
% Test double, float, dcomplex, fcomplex.

% --- double ---
$void NocopyTimesTwo_double(double *A, double *B, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) B[i] = 2.0 * A[i];
$}

$void NocopyInplace_double(double *A, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) A[i] = 3.0 * A[i];
$}

% --- float ---
$void NocopyTimesTwo_float(float *A, float *B, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) B[i] = 2.0f * A[i];
$}

% --- dcomplex ---
$void NocopyTimesTwo_dcomplex(dcomplex *A, dcomplex *B, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) B[i] = 2.0 * A[i];
$}

% --- fcomplex ---
$void NocopyTimesTwo_fcomplex(fcomplex *A, fcomplex *B, int const N)
${
$   int i;
$   for(i = 0; i<N; i++) B[i] = 2.0f * A[i];
$}

@function result = nocopy_timestwo_double(a)
  n = numel(a);
  # NocopyTimesTwo_double(cinput double[] a, coutput double[n] result, int n);
end

@function a = nocopy_inplace_double(a)
  n = numel(a);
  # NocopyInplace_double(cinout double[] a, int n);
end

@function result = nocopy_timestwo_float(a)
  n = numel(a);
  # NocopyTimesTwo_float(cinput float[] a, coutput float[n] result, int n);
end

@function result = nocopy_timestwo_dcomplex(a)
  n = numel(a);
  # NocopyTimesTwo_dcomplex(cinput dcomplex[] a, coutput dcomplex[n] result, int n);
end

@function result = nocopy_timestwo_fcomplex(a)
  n = numel(a);
