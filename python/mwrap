import sys
import os
import argparse

# Ensure the directory containing this script is on the path
_script_dir = os.path.dirname(os.path.abspath(__file__))
if _script_dir not in sys.path:
    sys.path.insert(0, _script_dir)

from mwrap_ast import MwrapContext
from mwrap_lexer import Lexer
from mwrap_parser import Parser
from mwrap_cgen import print_mex_init, print_mex_file
from mwrap_cppgen import print_cpp_init, print_cpp_file
from mwrap_octgen import print_oct_init, print_oct_file
from mwrap_fmexgen import print_fmex_init, print_fmex_file


HELP_STRING = """\
mwrap 1.4 - MEX/oct-file generator for MATLAB and Octave

Syntax:
  mwrap [-mex outputmex | -cppmex outputcpp | -oct outputoct | -fmex outputfmex]
        [-m output.m] [-c output.c]
        [-mb] [-list] [-catch] [-i8] [-c99complex] [-cppcomplex] [-gpu]
        infile1 infile2 ...

  -mex outputmex   -- generate MEX gateway (default, C API)
  -cppmex outputcpp -- generate MATLAB C++ MEX API gateway (R2018a+)
  -oct outputoct   -- generate Octave oct-file gateway
  -fmex outputfmex -- generate Fortran MEX gateway (pure Fortran, .f90)
  -m output.m      -- generate the MATLAB stub called output.m
  -c output.c      -- generate the C/C++ or Fortran file
  -mb              -- generate .m files specified with @ redirections
  -list            -- list files specified with @ redirections
  -catch           -- generate C++ exception handling code
  -i8              -- convert int, long, uint, ulong to int64_t, uint64_t
                      for -fmex: emit integer*8 for all integers
  -c99complex      -- add support code for C99 complex types
  -cppcomplex      -- add support code for C++ complex types
  -gpu             -- add support code for MATLAB gpuArray (MEX only)
"""

USAGE_STRING = """\
Usage: mwrap [-mex outputmex | -cppmex outputcpp | -oct outputoct | -fmex outputfmex] [-m output.m] [-c output.c] infile1 ...
Try 'mwrap --help' for more information.
"""


def _load_support():
    """Load the runtime support C file content."""
    support_path = os.path.join(_script_dir, "mwrap_support.c")
    with open(support_path, "r") as f:
        return f.read()


def _load_cpp_support():
    """Load the runtime support header for C++ MEX API."""
    support_path = os.path.join(_script_dir, "mwrap_cpp_support.c")
    with open(support_path, "r") as f:
        return f.read()


def _load_oct_support():
    """Load the runtime support header for oct-files."""
    support_path = os.path.join(_script_dir, "mwrap_oct_support.c")
    with open(support_path, "r") as f:
        return f.read()


def _load_fmex_support():
    """Load the runtime support module for Fortran MEX (iso_c_binding)."""
    support_path = os.path.join(_script_dir, "mwrap_fmex_support.f90")
    with open(support_path, "r") as f:
        return f.read()


def _build_parser():
    """Build the argparse argument parser."""
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument('--help', action='store_true', dest='help')
    p.add_argument('-m', dest='mfile')
    p.add_argument('-c', dest='cfile')
    p.add_argument('-mex', dest='mexfunc', default='mexfunction')
    p.add_argument('-cppmex', dest='cppfunc')
    p.add_argument('-oct', dest='octfunc')
    p.add_argument('-fmex', dest='fmexfunc')
    p.add_argument('-mb', action='store_true', dest='mbatching')
    p.add_argument('-list', action='store_true', dest='listing')
    p.add_argument('-catch', action='store_true', dest='catch_')
    p.add_argument('-i8', action='store_true')
    p.add_argument('-c99complex', action='store_true')
    p.add_argument('-cppcomplex', action='store_true')
    p.add_argument('-gpu', action='store_true')
    p.add_argument('input_files', nargs='*')
    return p


def main():
    ctx = MwrapContext()
    ctx.init_scalar_types()

    if len(sys.argv) < 2:
        sys.stderr.write(HELP_STRING)
        return 0

    p = _build_parser()
    args = p.parse_args()

    if args.help:
        sys.stderr.write(HELP_STRING)
        return 0

    # Determine backend mode
    cppmex_mode = args.cppfunc is not None
    oct_mode = args.octfunc is not None
    fmex_mode = args.fmexfunc is not None
    # If -cppmex was given, the user chose C++ MEX API mode
    # If -oct was given, the user explicitly chose oct-file mode
    # If -fmex was given, the user chose Fortran MEX mode
    # If -mex was given (or default), use C MEX mode

    exclusive_count = sum([oct_mode, cppmex_mode, fmex_mode])
    if exclusive_count > 1:
        sys.stderr.write("Error: -oct, -cppmex, and -fmex are mutually exclusive\n")
        return 1

    if fmex_mode and args.gpu:
        sys.stderr.write("Error: -fmex and -gpu cannot be used together\n")
        return 1

    if args.catch_:
        ctx.mw_generate_catch = True
    if args.i8:
        ctx.mw_promote_int = 4
    if args.c99complex:
        ctx.mw_use_c99_complex = True
    if args.cppcomplex:
        ctx.mw_use_cpp_complex = True
    if args.gpu:
        if oct_mode:
            sys.stderr.write("Error: -gpu is not supported with -oct (oct-files do not support GPU arrays)\n")
            return 1
        if cppmex_mode:
            sys.stderr.write("Note: -cppmex -gpu uses C MEX gateway (mxGPUArray API requires mxArray*)\n")
        ctx.mw_use_gpu = True

    if ctx.mw_use_c99_complex or ctx.mw_use_cpp_complex:
        ctx.add_zscalar_type("dcomplex")
        ctx.add_cscalar_type("fcomplex")

    if not args.input_files:
        sys.stderr.write(USAGE_STRING)
        return 0

    # --- Open output files ---
    outfp = None
    outcfp = None
    if args.mfile:
        outfp = open(args.mfile, "w")
    if args.cfile:
        outcfp = open(args.cfile, "w")

    # --- Create lexer and parser ---
    if oct_mode:
        gateway_name = args.octfunc
    elif cppmex_mode:
        gateway_name = args.cppfunc
    elif fmex_mode:
        gateway_name = args.fmexfunc
    else:
        gateway_name = args.mexfunc
    lexer = Lexer(outfp=outfp, outcfp=outcfp,
                  mbatching_flag=args.mbatching,
                  listing_flag=args.listing)
    parser = Parser(lexer, ctx, mexfunc=gateway_name)

    err_flag = 0
    emitted_init = False

    for infile in args.input_files:
        lexer.linenum = 1
        parser.type_errs = 0

        try:
            fp_test = open(infile, "r")
            fp_test.close()
        except OSError:
            sys.stderr.write(f"Could not read {infile}\n")
            continue

        lexer.current_ifname = infile

        if outcfp and not emitted_init:
            if fmex_mode:
                support_text = _load_fmex_support()
                print_fmex_init(outcfp, ctx, support_text)
            elif oct_mode:
                support_text = _load_oct_support()
                print_oct_init(outcfp, ctx, support_text)
            elif cppmex_mode and ctx.mw_use_gpu:
                support_text = _load_support()
                print_mex_init(outcfp, ctx, support_text)
            elif cppmex_mode:
                support_text = _load_cpp_support()
                print_cpp_init(outcfp, ctx, support_text)
            else:
                support_text = _load_support()
                print_mex_init(outcfp, ctx, support_text)
            emitted_init = True

        for tok in lexer.lex_file(infile):
            parser.feed(tok)

        parser.finish_file()
        err_flag += parser.err_flag
        parser.err_flag = 0

    # --- Generate output ---
    if not err_flag and outcfp:
        if fmex_mode:
            print_fmex_file(outcfp, ctx, parser.funcs, args.fmexfunc,
                            i8_mode=args.i8)
        elif oct_mode:
            print_oct_file(outcfp, ctx, parser.funcs, args.octfunc)
        elif cppmex_mode and ctx.mw_use_gpu:
            print_mex_file(outcfp, ctx, parser.funcs)
        elif cppmex_mode:
            print_cpp_file(outcfp, ctx, parser.funcs, args.cppfunc)
        else:
            print_mex_file(outcfp, ctx, parser.funcs)

    if outfp:
        outfp.close()
    if outcfp:
        outcfp.close()

    return err_flag


if __name__ == "__main__":
    sys.exit(main())
